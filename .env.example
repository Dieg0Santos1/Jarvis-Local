# Configuración del Cerebro de Jarvis (OpenAI Cloud o local con Ollama)
# Para usar un LLM 100% local en tu laptop con Ollama:
#   1. Instala Ollama en Windows (https://ollama.com).
#   2. Descarga un modelo en tu terminal, ej: `ollama pull llama3`
#   3. Configura: OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY=ollama y OPENAI_MODEL=llama3
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_WARMUP_FRAMES=12
CAMERA_INSPECTION_FRAMES=5
CAMERA_JPEG_QUALITY=94
JARVIS_OWNER_NAME=Diego Alexander Santos Aguilar
SECURITY_ENABLED=false
SECURITY_SESSION_SECONDS=300
FACE_RECOGNITION_THRESHOLD=78
FACE_ENROLLMENT_SAMPLES=18
JARVIS_LANGUAGE=es
WHISPER_MODEL=small
WHISPER_PROMPT=Asistente de voz en espanol. Comandos comunes: abre Chrome, abre Visual Studio Code, abre Spotify, abre GitHub, abre la terminal, abre el explorador de archivos, busca Bad Bunny en Google, que hora es.
VOICE_MAX_SECONDS=8
VOICE_SILENCE_SECONDS=1.2
VOICE_MIN_SPEECH_SECONDS=0.5
VOICE_ENERGY_THRESHOLD=0.015
WAKE_WORD=hey jarvis
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.18
WAKE_WORD_DEBUG=false
TTS_RATE=175
TTS_VOICE_HINT=helena
ELEVENLABS_ENABLED=true
ELEVENLABS_API_KEY=sk_b659cd4623ecf9117bcf2ca1240ec4a3a89c51d4820517c9
ELEVENLABS_VOICE_ID=
